{
  "name": "apple-connect-workflows-mcp",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Local App Store Connect MCP for release, TestFlight, assets, commerce, analytics and workflow plans",
  "keywords": [
    "app-store-connect",
    "mcp",
    "model-context-protocol",
    "testflight",
    "apple"
  ],
  "author": "Mesut Beysülen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mesutbeysulen/apple-connect-workflows-mcp.git"
  },
  "homepage": "https://github.com/mesutbeysulen/apple-connect-workflows-mcp#readme",
  "bugs": "https://github.com/mesutbeysulen/apple-connect-workflows-mcp/issues",
  "files": [
    "dist",
    "catalog",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "config.example.json"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "apple-connect-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "check": "tsc --noEmit",
    "test": "npm run build && tsx --test test/*.test.ts",
    "start": "node dist/cli.js serve",
    "dev": "tsx src/cli.ts serve",
    "catalog": "node scripts/build-catalog.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
